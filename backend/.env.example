# Comma-separated list of origins allowed to call this API from a browser.
# Use "*" to allow all (fine for local dev, tighten in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLAlchemy database URL. Defaults to a local SQLite file next to the app.
DATABASE_URL=sqlite:///./vehicle_tracker.db

# Unit system used by the fuel-economy endpoint: "imperial" (MPG) or "metric" (L/100km)
UNITS=imperial

# Port is injected by Railway/Render; only needed locally if you want a non-8000 port.
PORT=8000
